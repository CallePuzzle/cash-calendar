---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import Section from "../components/home/Section";
import logo from "../images/logo_cash_calendar2.png";
---

<Layout>
  <div
    class="p-5 flex flex-col md:p-0 md:flex-row md:items-center md:justify-around md:gap-20"
  >
    <Section />
    <div class="w-320 h-221 flex justify-center">
      <Image src={logo} alt="imagen" />
    </div>
  </div>
</Layout>
